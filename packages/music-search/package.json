{
    "name": "@spotify-to-plex/music-search",
    "version": "1.0.0",
    "description": "Library to find tracks in a music library.",
    "keywords": [
        "search",
        "music"
    ],
    "license": "MIT",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*/*": {
            "types": "./dist/*/*.d.ts",
            "default": "./dist/*/*.js"
        },
        "./*/*/*": {
            "types": "./dist/*/*/*.d.ts",
            "default": "./dist/*/*/*.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@spotify-to-plex/shared-types": "workspace:*",
        "@spotify-to-plex/shared-utils": "workspace:*",
        "fs-extra": "^11.4.0",
        "string-similarity-js": "^2.1.4"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.20.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^5.0.0"
    }
}
