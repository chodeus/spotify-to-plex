{
    "name": "@spotify-to-plex/plex-music-search",
    "version": "1.0.0",
    "description": "Library to find tracks in Plex",
    "keywords": [
        "plex",
        "music",
        "search"
    ],
    "license": "MIT",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*/*": {
            "types": "./dist/*/*.d.ts",
            "default": "./dist/*/*.js"
        },
        "./*/*/*": {
            "types": "./dist/*/*/*.d.ts",
            "default": "./dist/*/*/*.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@spotify-to-plex/http-client": "workspace:*",
        "@spotify-to-plex/music-search": "workspace:*",
        "@spotify-to-plex/shared-types": "workspace:*",
        "@spotify-to-plex/shared-utils": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vitest": "^5.0.5"
    }
}
